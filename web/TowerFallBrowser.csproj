<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Not "TowerFall": that is the name of the game assembly loaded at runtime. -->
		<AssemblyName>TowerFallBrowser</AssemblyName>
		<RootNamespace>TowerFallBrowser</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<InvariantGlobalization>true</InvariantGlobalization>
		
		<CompressionEnabled>false</CompressionEnabled>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>
		<!-- The patched runtime pack (tools/fetch-runtime.sh); -p:RuntimeDir=... builds against another. -->
		<RuntimeDir Condition="'$(RuntimeDir)' == ''">$(MSBuildProjectDirectory)\..\vendor\runtime</RuntimeDir>

		<NoWarn>IL2026,IL2046,IL2057,IL2062,IL2065,IL2067,IL2070,IL2072,IL2075,IL2087,IL2090</NoWarn>
		<NoWarn>$(NoWarn),SYSLIB0011,SYSLIB0050,SYSLIB0051,CS0169,CS0219,CS0414,CS0618,CS0649,CS0162,CS0168,CS8981,CA2022,CA1416,CS0108,CS0114</NoWarn>

		<!-- Plain .dll files in _framework/, so MonoMod/Cecil can read them (see BrowserHost.MountAssemblies). -->
		<WasmEnableWebcil>false</WasmEnableWebcil>

		<WasmBuildNative>true</WasmBuildNative>
		<WasmEnableThreads>true</WasmEnableThreads>
		<WasmEnableSIMD>true</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>

		<WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
		<WasmBitcodeCompileOptimizationFlag>-O3</WasmBitcodeCompileOptimizationFlag>
		<WasmNativeStrip>true</WasmNativeStrip>
		<WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>

		<EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES2 -sFULL_ES3 -sWASMFS -sOFFSCREENCANVAS_SUPPORT</EmccExtraLDFlags>
		<EmccLinkOptimizationFlag>-O3</EmccLinkOptimizationFlag>
		<EmccCompileOptimizationFlag>-O3</EmccCompileOptimizationFlag>
		<EmccEnvironment>web,worker</EmccEnvironment>
		<EmccInitialHeapSize>536870912</EmccInitialHeapSize>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Steamworks.NET\**" />

		<NativeFileReference Include="..\vendor\statics\SDL3.a" />
		<NativeFileReference Include="..\vendor\statics\FNA3D.a" />
		<NativeFileReference Include="..\vendor\statics\libmojoshader.a" />
		<NativeFileReference Include="..\vendor\statics\FAudio.a" />
		<NativeFileReference Include="Native\Emscripten.c" />
		<!-- MonoMod's WebAssembly detours: interpreter hooks (liba) and a hot-reload component that
		     serves detoured method bodies (hot_reload_detour); both from tools/fetch-runtime.sh. -->
		<NativeFileReference Include="$(RuntimeDir)\liba.o" Condition="Exists('$(RuntimeDir)\liba.o')" />
		<NativeFileReference Include="$(RuntimeDir)\hot_reload_detour.o" Condition="Exists('$(RuntimeDir)\hot_reload_detour.o')" />
		<!-- Netplay: ggrs_ffi (TF.EX's native library, built by tools/build-netplay.sh) and its
		     browser WebRTC transport. The archive name is the P/Invoke library name. -->
		<NativeFileReference Include="..\vendor\netplay\ggrs_ffi.a" Condition="Exists('..\vendor\netplay\ggrs_ffi.a')" />
		<_WasmExtraJSFile Include="..\netplay\tfnet.js" Kind="js-library" Condition="Exists('..\vendor\netplay\ggrs_ffi.a')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\vendor\FNA\FNA.Core.csproj" />
		<!-- Not used by the host itself; published so the game's Steamworks.NET reference binds to it. -->
		<ProjectReference Include="Steamworks.NET\Steamworks.NET.csproj" />
	</ItemGroup>
	<!-- Patched Mono runtime pack (tools/fetch-runtime.sh): MonoMod's WebAssembly detours, which
	     Harmony-based FortRise mods need, rely on its interpreter changes. -->
	<PropertyGroup Condition="Exists('$(RuntimeDir)\dotnet')">
		<MicrosoftNetCoreAppRuntimePackDir>$(RuntimeDir)\dotnet</MicrosoftNetCoreAppRuntimePackDir>
		<MicrosoftNetCoreAppRuntimePackRidDir>$(MicrosoftNetCoreAppRuntimePackDir)\runtimes\browser-wasm</MicrosoftNetCoreAppRuntimePackRidDir>
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>
	<Target Name="UsePatchedRuntimePack" AfterTargets="ResolveFrameworkReferences" Condition="'$(MicrosoftNetCoreAppRuntimePackDir)' != ''">
		<ItemGroup>
			<ResolvedRuntimePack PackageDirectory="$(MicrosoftNetCoreAppRuntimePackDir)"
				Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
		</ItemGroup>
		<Message Text="Using patched runtime pack: %(ResolvedRuntimePack.PackageDirectory)" Importance="High" />
	</Target>

	<Import Project="FortRise\FortRise.References.props" />
	<!-- Ahead-of-time compiled build (tools/build.sh AOT=1; see docs/COMPILATION.md, option A).
	     Only the site's own assemblies are compiled; the game and mods load at run time and stay
	     interpreted. -->
	<PropertyGroup Condition="'$(RunAOTCompilation)' == 'true'">
		<!-- Keep IL: Cecil and MonoMod read framework assemblies (FortRise's relinker, detours). -->
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<!-- AOT requires the trimmer to run, but nothing may be trimmed: the game and mods load at
		     run time and can use any framework API (see KeepAllAssemblies below). -->
		<PublishTrimmed>true</PublishTrimmed>
		<!-- PublishTrimmed also flips feature switches to trimmed-app defaults; keep the untrimmed ones
		     (mods use DI open generics, reflection-based JSON, nullability info; MonoMod's detours
		     need the hot-reload metadata updater). -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
		<VerifyDependencyInjectionOpenGenericServiceTrimmability>false</VerifyDependencyInjectionOpenGenericServiceTrimmability>
		<MetadataUpdaterSupport>true</MetadataUpdaterSupport>
		<NullabilityInfoContextSupport>true</NullabilityInfoContextSupport>
		<_AggressiveAttributeTrimming>false</_AggressiveAttributeTrimming>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<!-- Outside the repo: the compiler runs LLVM through a shell, which breaks on paths with spaces
		     (build AOT from a space-free path too, e.g. a symlink to the repo). -->
		<AotCrossCompilerDir Condition="'$(AotCrossCompilerDir)' == ''">$(HOME)/.towerfall-browser/tools/aot-cross/10.0.3/tools</AotCrossCompilerDir>
	</PropertyGroup>
	<ItemGroup Condition="'$(RunAOTCompilation)' == 'true'">
		<!-- Patched at run time (PolledWebSocket), which compiled code can't honour. -->
		<_AOT_InternalForceInterpretAssemblies Include="System.Net.WebSockets.Client.dll" />
	</ItemGroup>
	<Target Name="KeepAllAssemblies" BeforeTargets="PrepareForILLink" Condition="'$(RunAOTCompilation)' == 'true'">
		<ItemGroup>
			<ManagedAssemblyToLink Update="@(ManagedAssemblyToLink)" TrimMode="copy" />
		</ItemGroup>
	</Target>
	<!-- The AOT compiler matching the patched runtime pack (10.0.3) instead of the workload's; the
	     workload adds its own after this file is evaluated, hence a target. -->
	<Target Name="UseMatchingAotCompiler" BeforeTargets="PrepareForILLink" Condition="'$(RunAOTCompilation)' == 'true' and Exists('$(AotCrossCompilerDir)\mono-aot-cross')">
		<ItemGroup>
			<MonoAotCrossCompiler Remove="@(MonoAotCrossCompiler)" />
			<MonoAotCrossCompiler Include="$(AotCrossCompilerDir)\mono-aot-cross" RuntimeIdentifier="browser-wasm" />
		</ItemGroup>
	</Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Not "TowerFall": that is the name of the game assembly loaded at runtime. -->
		<AssemblyName>TowerFallBrowser</AssemblyName>
		<RootNamespace>TowerFallBrowser</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<InvariantGlobalization>true</InvariantGlobalization>
		
		<CompressionEnabled>false</CompressionEnabled>
		<PublishTrimmed>false</PublishTrimmed>
		<RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">false</RunAOTCompilation>

		<NoWarn>IL2026,IL2046,IL2057,IL2062,IL2065,IL2067,IL2070,IL2072,IL2075,IL2087,IL2090</NoWarn>
		<NoWarn>$(NoWarn),SYSLIB0011,SYSLIB0050,SYSLIB0051,CS0169,CS0219,CS0414,CS0618,CS0649,CS0162,CS0168,CS8981,CA2022,CA1416,CS0108,CS0114</NoWarn>

		<!-- Plain .dll files in _framework/, so MonoMod/Cecil can read them (see BrowserHost.MountAssemblies). -->
		<WasmEnableWebcil>false</WasmEnableWebcil>

		<WasmBuildNative>true</WasmBuildNative>
		<WasmEnableThreads>true</WasmEnableThreads>
		<WasmEnableSIMD>true</WasmEnableSIMD>
		<WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>

		<WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
		<WasmBitcodeCompileOptimizationFlag>-O3</WasmBitcodeCompileOptimizationFlag>
		<WasmNativeStrip>true</WasmNativeStrip>
		<WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>

		<EmccExtraLDFlags>-sMIN_WEBGL_VERSION=2 -sMAX_WEBGL_VERSION=2 -sFULL_ES2 -sFULL_ES3 -sWASMFS -sOFFSCREENCANVAS_SUPPORT</EmccExtraLDFlags>
		<EmccLinkOptimizationFlag>-O3</EmccLinkOptimizationFlag>
		<EmccCompileOptimizationFlag>-O3</EmccCompileOptimizationFlag>
		<EmccEnvironment>web,worker</EmccEnvironment>
		<EmccInitialHeapSize>536870912</EmccInitialHeapSize>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Steamworks.NET\**" />

		<NativeFileReference Include="..\vendor\statics\SDL3.a" />
		<NativeFileReference Include="..\vendor\statics\FNA3D.a" />
		<NativeFileReference Include="..\vendor\statics\libmojoshader.a" />
		<NativeFileReference Include="..\vendor\statics\FAudio.a" />
		<NativeFileReference Include="Native\Emscripten.c" />
		<!-- MonoMod's WebAssembly detours: interpreter hooks (liba) and a hot-reload component that
		     serves detoured method bodies (hot_reload_detour); both from tools/fetch-runtime.sh. -->
		<NativeFileReference Include="..\vendor\runtime\liba.o" Condition="Exists('..\vendor\runtime\liba.o')" />
		<NativeFileReference Include="..\vendor\runtime\hot_reload_detour.o" Condition="Exists('..\vendor\runtime\hot_reload_detour.o')" />
		<!-- Netplay: ggrs_ffi (TF.EX's native library, built by tools/build-netplay.sh) and its
		     browser WebRTC transport. The archive name is the P/Invoke library name. -->
		<NativeFileReference Include="..\vendor\netplay\ggrs_ffi.a" Condition="Exists('..\vendor\netplay\ggrs_ffi.a')" />
		<_WasmExtraJSFile Include="..\netplay\tfnet.js" Kind="js-library" Condition="Exists('..\vendor\netplay\ggrs_ffi.a')" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\vendor\FNA\FNA.Core.csproj" />
		<!-- Not used by the host itself; published so the game's Steamworks.NET reference binds to it. -->
		<ProjectReference Include="Steamworks.NET\Steamworks.NET.csproj" />
	</ItemGroup>
	<!-- Patched Mono runtime pack (tools/fetch-runtime.sh): MonoMod's WebAssembly detours, which
	     Harmony-based FortRise mods need, rely on its interpreter changes. -->
	<PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\vendor\runtime\dotnet')">
		<MicrosoftNetCoreAppRuntimePackDir>$(MSBuildProjectDirectory)\..\vendor\runtime\dotnet</MicrosoftNetCoreAppRuntimePackDir>
		<MicrosoftNetCoreAppRuntimePackRidDir>$(MicrosoftNetCoreAppRuntimePackDir)\runtimes\browser-wasm</MicrosoftNetCoreAppRuntimePackRidDir>
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>
	<Target Name="UsePatchedRuntimePack" AfterTargets="ResolveFrameworkReferences" Condition="'$(MicrosoftNetCoreAppRuntimePackDir)' != ''">
		<ItemGroup>
			<ResolvedRuntimePack PackageDirectory="$(MicrosoftNetCoreAppRuntimePackDir)"
				Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
		</ItemGroup>
		<Message Text="Using patched runtime pack: %(ResolvedRuntimePack.PackageDirectory)" Importance="High" />
	</Target>

	<Import Project="FortRise\FortRise.References.props" />
</Project>

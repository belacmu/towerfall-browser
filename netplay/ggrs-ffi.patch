+// The checksum the game computed for the state it saves next (ffi netplay_set_pending_checksum): used once instead
+// of fletcher16 of the serialized state, so a peer that can't serialize TF.EX's state (the Switch) can compare a digest.
+pub static PENDING_CHECKSUM: Mutex<Option<u64>> = Mutex::new(None);
+
 pub struct Netplay {

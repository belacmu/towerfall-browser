<Project Sdk="Microsoft.NET.Sdk">
	<!-- Desktop harness for web/FortRise/FortRisePatcher.cs: patches a TowerFall.exe with FortRise
	     exactly as the browser host does, so the patch step can be tested and debugged natively. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\..\web\FortRise\FortRisePatcher.cs" />
		<Compile Include="..\..\web\FortRise\BrowserShims.cs" />
	</ItemGroup>
	<Import Project="..\..\web\FortRise\FortRise.References.props" />
</Project>

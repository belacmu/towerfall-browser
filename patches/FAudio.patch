diff --git a/src/FAudio_platform_sdl3.c b/src/FAudio_platform_sdl3.c
index f45892e..2e66b18 100644
--- a/src/FAudio_platform_sdl3.c
+++ b/src/FAudio_platform_sdl3.c
@@ -36,6 +36,14 @@ typedef struct SDLAudioDevice
 	SDL_AudioStream *stream;
 	float *stagingBuffer;
 	size_t stagingLen;
+#ifdef __EMSCRIPTEN__
+	SDL_Thread *mixThread;
+	SDL_AtomicInt mixRunning;
+	Uint64 quantumNS;
+	Uint64 blockNS;
+	int blockBytes;
+	int marginBytes;
+#endif
 } SDLAudioDevice;
 
 /* Mixer Thread */
@@ -67,6 +75,62 @@ static void FAudio_INTERNAL_MixCallback(
 	}
 }
 
+#ifdef __EMSCRIPTEN__
+
+/* In the browser SDL runs the playback callback on the page's main thread (in
+ * Web Audio's callback, or on a timer while audio is suspended). The main
+ * thread must never wait, but mixing can: streaming wave banks read their file
+ * as they play, and a storage (OPFS) read from the main thread never completes
+ * in Safari, freezing the page. So FAudio mixes on its own thread into the
+ * device's stream, and the main thread only takes finished samples.
+ *
+ * Web Audio takes a whole block at a time (4096 frames, ~85 ms). Mixing the
+ * next block all at once would delay every sound by a block, so the thread
+ * paces itself: after each take it mixes in step with the clock, so the next
+ * block is complete just before it's due (plus a two-quantum margin).
+ */
+static int FAudio_INTERNAL_MixThread(void *userdata)
+{
+	SDLAudioDevice *dev = (SDLAudioDevice*) userdata;
+	Uint64 taken = SDL_GetTicksNS();
+	int last = 0;
+
+	while (SDL_GetAtomicInt(&dev->mixRunning))
+	{
+		const Uint64 now = SDL_GetTicksNS();
+		const int queued = SDL_GetAudioStreamQueued(dev->stream);
+		Uint64 elapsed;
+		int wanted;
+
+		if (queued < last - dev->blockBytes / 2)
+		{
+			taken = now; /* the device just took a block */
+		}
+		elapsed = SDL_min(now - taken, dev->blockNS);
+		wanted = dev->marginBytes + (int) ((Uint64) dev->blockBytes * elapsed / dev->blockNS);
+
+		if (dev->audio->active && queued < wanted)
+		{
+			FAudio_zero(dev->stagingBuffer, dev->stagingLen);
+			FAudio_INTERNAL_UpdateEngine(dev->audio, dev->stagingBuffer);
+			SDL_PutAudioStreamData(
+				dev->stream,
+				dev->stagingBuffer,
+				(int) dev->stagingLen
+			);
+			last = queued + (int) dev->stagingLen;
+		}
+		else
+		{
+			last = queued;
+			SDL_DelayNS(dev->quantumNS / 4);
+		}
+	}
+	return 0;
+}
+
+#endif /* __EMSCRIPTEN__ */
+

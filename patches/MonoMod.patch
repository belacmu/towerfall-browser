diff --git a/src/MonoMod.Utils/DirectAccessors.cs b/src/MonoMod.Utils/DirectAccessors.cs
new file mode 100644
index 0000000..e7ef7c3
--- /dev/null
+++ b/src/MonoMod.Utils/DirectAccessors.cs
@@ -0,0 +1,52 @@
+using System;
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace MonoMod.Utils
+{
+    // TowerFall browser: field getters/setters as tiny dynamic methods (ldfld/stfld), for DynamicData.
+    internal static class DirectAccessors
+    {
+        public static Func<object?, object?> Getter(FieldInfo field)
+        {
+            var owner = field.DeclaringType!;
+            if (field.FieldType.IsPointer || field.FieldType.IsByRef || field.FieldType.IsByRefLike)
+                throw new NotSupportedException();
+            var method = new DynamicMethod("DynamicData_get_" + field.Name, typeof(object), new[] { typeof(object) }, owner, skipVisibility: true);
+            var il = method.GetILGenerator();
+            if (field.IsStatic)
+            {
+                il.Emit(OpCodes.Ldsfld, field);
+            }
+            else
+            {
+                il.Emit(OpCodes.Ldarg_0);
+                il.Emit(owner.IsValueType ? OpCodes.Unbox : OpCodes.Castclass, owner);
+                il.Emit(OpCodes.Ldfld, field);
+            }
+            if (field.FieldType.IsValueType)
+                il.Emit(OpCodes.Box, field.FieldType);
+            il.Emit(OpCodes.Ret);
+            return (Func<object?, object?>)method.CreateDelegate(typeof(Func<object?, object?>));
+        }
+
+        public static Action<object?, object?> Setter(FieldInfo field)
+        {
+            var owner = field.DeclaringType!;
+            if (field.IsInitOnly || field.IsLiteral || field.FieldType.IsPointer || field.FieldType.IsByRef || field.FieldType.IsByRefLike)
+                throw new NotSupportedException();
+            var method = new DynamicMethod("DynamicData_set_" + field.Name, null, new[] { typeof(object), typeof(object) }, owner, skipVisibility: true);
+            var il = method.GetILGenerator();
+            if (!field.IsStatic)
+            {
+                il.Emit(OpCodes.Ldarg_0);
+                il.Emit(owner.IsValueType ? OpCodes.Unbox : OpCodes.Castclass, owner);
+            }
+            il.Emit(OpCodes.Ldarg_1);
+            il.Emit(OpCodes.Unbox_Any, field.FieldType);
+            il.Emit(field.IsStatic ? OpCodes.Stsfld : OpCodes.Stfld, field);
+            il.Emit(OpCodes.Ret);
+            return (Action<object?, object?>)method.CreateDelegate(typeof(Action<object?, object?>));
+        }
+    }
+}
